@page
@model FUNewsManagementSystemRazorPages.Pages.NewsArticles.DeleteModel
@{
    ViewData["Title"] = "Delete News Article";
}

<h2>Delete News Article</h2>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this article?</h4>
</div>

<table class="table table-bordered">
    <tr>
        <th>Title</th>
        <td>@Model.NewsArticle.NewsTitle</td>
    </tr>
    <tr>
        <th>Headline</th>
        <td>@Model.NewsArticle.Headline</td>
    </tr>
    <tr>
        <th>Created Date</th>
        <td>@Model.NewsArticle.CreatedDate?.ToString("yyyy-MM-dd")</td>
    </tr>
    <tr>
        <th>Category</th>
        <td>@Model.NewsArticle.CategoryName</td>
    </tr>
    <tr>
        <th>Tags</th>
        <td>
            @if (Model.NewsArticle.Tags != null && Model.NewsArticle.Tags.Any())
            {
                @string.Join(", ", Model.NewsArticle.Tags.Select(tag => tag.TagName))
            }
            else
            {
                <em>No Tags</em>
            }
        </td>
    </tr>
</table>


<!-- Delete Button triggers Modal -->
<button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal">
    Delete
</button>
    |
<div>
    <a asp-page="./Index">Back to List</a>
</div>
<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this news article? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <<form method="post">
                    <input type="hidden" asp-for="NewsArticle.NewsArticleId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

